{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coco-kemon",
  "main": ".worker-build/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "GEMINI_API_KEY"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "QUARKPOP_CACHE",
      "id": "57cee4777c8746c1a6273e81499d9d61"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "no_bundle": true,
  "build": {
    "command": "node scripts/build-worker.mjs",
    "watch_dir": [
      "server.ts",
      "server",
      "src/lib",
      "worker.ts"
    ]
  }
}
