{
  "name": "oddkin-foundry-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "android:init": "node -e \"require('fs').rmSync('android',{recursive:true,force:true})\" && npx cap add android",
    "android:sync": "npx cap sync android",
    "android:assets": "npx capacitor-assets generate --android --assetPath ../public --iconBackgroundColor=#ffffff --iconBackgroundColorDark=#111111 --splashBackgroundColor=#ffffff --splashBackgroundColorDark=#111111",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
